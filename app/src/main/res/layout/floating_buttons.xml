<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="5dp"
    android:background="#EE18243A"
    android:elevation="8dp">

    <TextView
        android:id="@+id/btnUp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="▲"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:contentDescription="Desplazar contenido hacia arriba"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btnPause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⏸"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:contentDescription="Pausar desplazamiento"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btnDown"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="▼"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:contentDescription="Desplazar contenido hacia abajo"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="✕"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:contentDescription="Cerrar controles flotantes"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground" />
</LinearLayout>